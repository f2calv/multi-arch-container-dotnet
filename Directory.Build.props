<Project>

  <PropertyGroup>
    <RootNamespace>CasCap</RootNamespace>
    <LangVersion>15.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--nullable we disable on a per project basis-->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Author>Alex Vincent</Author>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' OR '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GitRepository" Value="$(GitRepository)" />
    <AssemblyMetadata Include="GitBranch" Value="$(GitBranch)" />
    <AssemblyMetadata Include="GitCommit" Value="$(SourceRevisionId)" />
    <AssemblyMetadata Include="BuildWorkflow" Value="$(BuildWorkflow)" />
    <AssemblyMetadata Include="BuildRunId" Value="$(BuildRunId)" />
    <AssemblyMetadata Include="BuildRunNumber" Value="$(BuildRunNumber)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- CS0162 - Unreachable code detected. -->
    <!-- S125 - Remove this commented out code. -->
    <!-- NETSDK1233 - Targeting .NET 10.0 or higher in Visual Studio 2022 XX.XX is not supported. -->
    <NoWarn>CS0162;S125;NETSDK1233</NoWarn>
  </PropertyGroup>

</Project>
