    "app": {
        "greeting": "Hello from a multi-architecture container",
        "interval_seconds": 3,
        "log_format": "text"
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    }
}